# Prompt Library - production/staging environment
# Used by the %staging and %prod profiles in application.properties.
# If the API runs on core.home itself, replace core.home with 127.0.0.1 below.

DB_URL=jdbc:mysql://{host}:{port}/promptlib_prod?sslMode=PREFERRED&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=prod
DB_PASSWORD=CHANGE_ME

OIDC_URL=http://{host}:{port}/realms/prompt-library
OIDC_CLIENT_ID=prompt-library-api

KEYCLOAK_BASE_URL=http://{host}:{port}
KEYCLOAK_REALM=prompt-library
KEYCLOAK_LOGIN_CLIENT_ID=prompt-library-api
KEYCLOAK_LOGIN_CLIENT_SECRET=dev-secret-change-me
KEYCLOAK_REGISTER_CLIENT_ID=prompt-library-api
KEYCLOAK_REGISTER_CLIENT_SECRET=dev-secret-change-me
