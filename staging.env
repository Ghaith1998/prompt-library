# Prompt Library - production/staging environment
# Used by the %staging and %prod profiles in application.properties.
# If the API runs on core.home itself, replace core.home with 127.0.0.1 below.

DB_URL=jdbc:mysql://{host}:{port}/promptlib_prod?sslMode=PREFERRED&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=promptlib_app
DB_PASSWORD=CHANGE_ME

OIDC_URL=http://{host}:{port}/realms/promptlib
OIDC_CLIENT_ID=promptlib-edge

KEYCLOAK_BASE_URL=http://{host}:{port}
KEYCLOAK_REALM=promptlib
KEYCLOAK_LOGIN_CLIENT_ID=promptlib-app
KEYCLOAK_LOGIN_CLIENT_SECRET=
KEYCLOAK_REGISTER_CLIENT_ID=promptlib-register
KEYCLOAK_REGISTER_CLIENT_SECRET=dev-only-register-secret
